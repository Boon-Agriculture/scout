# Scout by Boon Agriculture: brand settings read by .github/workflows/scout-android.yml
# A new brand = a copy of this folder with its own values and pictures.
APP_NAME=Scout
APP_PACKAGE_NAME=scout
APP_ID=com.boonagric.scout
APP_CLOUD_URL=https://cloud.boonagric.com
APP_CLOUD_NAME="Scout Cloud"
APP_WEBSITE=https://boonagric.com
APP_SOURCE_URL=https://github.com/Boon-Agriculture/scout
# Internal icon file name kept as QField's so every place that uses the icon picks up ours.
APP_ICON=qfield_logo
# Company name printed on map prints next to the app name.
APP_PUBLISHER="Boon Agriculture"
# Font used across the app; files listed in fonts.txt are downloaded and checked at build time.
APP_FONT_FAMILY=Archivo
