+namespace
+{
+  /**
+   * Branded builds print a line along the foot of the first page: brand, print time and
+   * the corners of the printed map area in WGS84. Returns the temporary label (removed after export).
+   */
+  QgsLayoutItemLabel *addBrandPrintStamp( QgsPrintLayout *layout, QString &temporaryMapId )
+  {
+    temporaryMapId.clear();
+    if ( !Qfield::isWhiteLabel() || !layout || layout->pageCollection()->pageCount() == 0 )
+      return nullptr;
+
+    QStringList parts;
+    parts << ( Qfield::appPublisher.isEmpty() ? Qfield::appName : QStringLiteral( "%1 by %2" ).arg( Qfield::appName, Qfield::appPublisher ) );
+    parts << QObject::tr( "Printed %1" ).arg( QStringLiteral( "[%format_date(now(), 'yyyy-MM-dd HH:mm')%]" ) );
+
+    QgsLayoutItemMap *map = layout->referenceMap();
+    if ( map )
+    {
+      if ( map->id().isEmpty() )
+      {
+        temporaryMapId = QStringLiteral( "brand_print_stamp_map" );
+        map->setId( temporaryMapId );
+      }
+      const QString vars = QStringLiteral( "item_variables('%1')" ).arg( map->id().replace( '\'', QStringLiteral( "''" ) ) );
+      const QString extent = QStringLiteral( "transform(map_get(%1, 'map_extent'), map_get(%1, 'map_crs'), 'EPSG:4326')" ).arg( vars );
+      parts << QObject::tr( "Map area (WGS84) SW %1, %2 NE %3, %4" )
+                 .arg( QStringLiteral( "[%round(y_min(" ) + extent + QStringLiteral( "), 5)%]" ),
+                       QStringLiteral( "[%round(x_min(" ) + extent + QStringLiteral( "), 5)%]" ),
+                       QStringLiteral( "[%round(y_max(" ) + extent + QStringLiteral( "), 5)%]" ),
+                       QStringLiteral( "[%round(x_max(" ) + extent + QStringLiteral( "), 5)%]" ) );
+    }
+
+    QgsLayoutItemPage *page = layout->pageCollection()->page( 0 );
+    const QRectF pageRect( page->pos(), page->rect().size() );
+    const double margin = std::min( 5.0, pageRect.width() * 0.02 );
+    const double height = 6.0;
+
+    QgsLayoutItemLabel *label = new QgsLayoutItemLabel( layout );
+    label->setText( parts.join( QStringLiteral( "  |  " ) ) );
+    QgsTextFormat format;
+    QFont font = QGuiApplication::font();
+    font.setPointSizeF( 7 );
+    format.setFont( font );
+    format.setSize( 7 );
+    format.setColor( QColor( 30, 39, 66 ) );
+    label->setTextFormat( format );
+    label->setMarginX( 1.5 );
+    label->setMarginY( 0.5 );
+    label->setVAlign( Qt::AlignVCenter );
+    label->setBackgroundEnabled( true );
+    label->setBackgroundColor( QColor( 255, 255, 255, 220 ) );
+    label->setFrameEnabled( false );
+    layout->addLayoutItem( label );
+    label->attemptSetSceneRect( QRectF( pageRect.left() + margin, pageRect.bottom() - margin - height, pageRect.width() - 2 * margin, height ) );
+    label->setZValue( 100000 );
+    label->refresh();
+    return label;
+  }
+
+  void removeBrandPrintStamp( QgsPrintLayout *layout, QgsLayoutItemLabel *label, const QString &temporaryMapId )
+  {
+    if ( !layout )
+      return;
+    if ( label )
+      layout->removeLayoutItem( label );
+    if ( !temporaryMapId.isEmpty() && layout->referenceMap() && layout->referenceMap()->id() == temporaryMapId )
+      layout->referenceMap()->setId( QString() );
+  }
